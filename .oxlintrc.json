{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": ["loader", "handle"]
      }
    ],
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "(^|/)\\.\\.(/|$)",
            "message": "Import through the @/ alias; relative imports are for ./ siblings only."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app|features|entities)(/|$)",
                "message": "The src/shared layer imports nothing from app, features or entities (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app|features)(/|$)",
                "message": "entities import only from the src/shared layer (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app(/|$)|features$)",
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "group": ["@/features/**"],
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/auth/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app(/|$)|features$)",
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "group": ["@/features/**", "!@/features/auth/**"],
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/cv-list/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app(/|$)|features$)",
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "group": ["@/features/**", "!@/features/cv-list/**"],
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/cv-create/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app(/|$)|features$)",
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "group": ["@/features/**", "!@/features/cv-create/**"],
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/cv-editor/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app(/|$)|features$)",
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "group": ["@/features/**", "!@/features/cv-editor/**"],
                "message": "A feature imports only from itself, entities and the src/shared layer (ADR 0002)."
              },
              {
                "regex": "^@/(mocks|tests)(/|$)",
                "message": "No layer imports src/mocks or src/tests (ADR 0003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/mocks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)\\.\\.(/|$)",
                "message": "Import through the @/ alias; relative imports are for ./ siblings only."
              },
              {
                "regex": "^@/(app|features|entities|shared|tests)(/|$)",
                "message": "src/mocks imports only the contract package and itself, nothing from the layers (ADR 0003)."
              }
            ]
          }
        ]
      }
    }
  ]
}
